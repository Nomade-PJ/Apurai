# --- Fonte oficial (TSE) ---
# Opcional: sobrescreve a URL derivada de lib/config/election.ts. Em branco = usa o padrão EA20 do TSE.
OFFICIAL_DATA_URL=
# Texto opcional exibido junto aos números (padrão: "<cargo> — <turno> (TSE)").
OFFICIAL_DATA_LABEL=
# Intervalo mínimo entre consultas à fonte, em segundos (mínimo aceito: 10; padrão: 20).
OFFICIAL_DATA_TTL_SECONDS=20
# SOMENTE desenvolvimento: aceita arquivos de simulado (f = "s"). Ignorado em produção.
OFFICIAL_ALLOW_SIMULATED=false

