# ===== Apuraí — variáveis de ambiente (valores FICTÍCIOS de exemplo; nunca versione valores reais) =====
# Copie para .env.local (desenvolvimento) e configure o mesmo conjunto no painel da hospedagem (produção).

NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# --- Supabase (SOMENTE servidor; NUNCA use prefixo NEXT_PUBLIC_ nestas duas) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Fonte oficial (TSE) ---
OFFICIAL_DATA_URL=
OFFICIAL_DATA_LABEL=
OFFICIAL_DATA_TTL_SECONDS=20
OFFICIAL_ALLOW_SIMULATED=false

# --- Painel administrativo ---
# Gere com: npm run hash-password -- "sua-senha-forte-com-12-ou-mais-caracteres"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Contato comercial ---
WHATSAPP_NUMBER=55DDDNUMERO
NEXT_PUBLIC_CONTACT_EMAIL=contato@seu-dominio.com.br

# --- Somente desenvolvimento ---
ALLOW_MEMORY_STORE=true

NEXT_PUBLIC_OPERATOR_NAME=Nome do responsável